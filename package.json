{
  "name": "saathi",
  "version": "0.1.0",
  "private": true,
  "description": "Morning phone companion for a parent in India, plus a family desk.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 43147",
    "predev": "npx --yes @tailwindcss/cli -i ./src/app/globals.css -o ./src/generated/app.css --minify",
    "prebuild": "npx --yes @tailwindcss/cli -i ./src/app/globals.css -o ./src/generated/app.css --minify",
    "build": "next build",
    "start": "next start --port 43147",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "npx --yes tsx src/lib/db/seed-cli.ts",
    "db:migrate": "npx --yes tsx src/lib/db/migrate-cli.ts",
    "test": "npx --yes tsx --test --test-concurrency=1 $(find src scripts -name '*.test.ts' -not -path '*/node_modules/*' | sort)",
    "e2e": "npm run build && playwright test",
    "bolna:sync": "npx --yes tsx scripts/bolna/sync.ts",
    "bolna:test-call": "npx --yes tsx scripts/bolna/test-call.ts",
    "whatsapp:templates": "npx --yes tsx scripts/whatsapp/templates.ts",
    "whatsapp:test-send": "npx --yes tsx scripts/whatsapp/test-send.ts",
    "brand:build": "npx --yes tsx scripts/brand/build.ts",
    "brand:screens": "npx --yes tsx scripts/brand/screens.ts",
    "android:apk": "npx --yes tsx scripts/android/build.ts debug",
    "android:release": "npx --yes tsx scripts/android/build.ts release"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@electric-sql/pglite": "^0.5.10",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "shadcn": "^4.22.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
