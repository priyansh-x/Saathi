# Names only. Never commit values.
# Copy to .env.local. Keep MOCK_*=1 until you mean to go live.
# Deploy notes: docs/saathi/engineering/deploy.md

# Product
PRODUCT_NAME=Saathi
BRIEFING_CHANNEL=whatsapp
LANGUAGES=hi,en
PUBLIC_BASE_URL=http://127.0.0.1:43147
# Hosted family origin the Android shell loads. Must be https except `npx cap sync --dev`.
SAATHI_APP_URL=
# Local release signing only. Never commit the keystore or these values.
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
VIEWER_TZ=

# Desk session HMAC. Required in production (Vercel NODE_ENV=production) even with mocks on.
# openssl rand -hex 32
SESSION_SECRET=
# Deprecated alias for SESSION_SECRET.
MAGIC_LINK_SECRET=

# Optional Postgres later. Empty = local PGlite at .data/saathi
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bolna (leave empty on staging; MOCK_BOLNA=1)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=
# Required in production even with MOCK_BOLNA=1. Must differ from BOLNA_WEBHOOK_SECRET.
# openssl rand -hex 32
BOLNA_TOOL_TOKEN=
# Deprecated alias for BOLNA_TOOL_TOKEN. Prefer BOLNA_TOOL_TOKEN.
SAATHI_TOOL_TOKEN=
# openssl rand -hex 32
BOLNA_WEBHOOK_SECRET=
# Required in production even with MOCK_BOLNA=1. Must differ from SESSION_SECRET, BOLNA_TOOL_TOKEN, and BOLNA_WEBHOOK_SECRET.
# openssl rand -hex 32
CRON_SECRET=
MOCK_BOLNA=1
CALL_PROVIDER=simulated
# Default 0. Set 1 only if Priyansh wants Bolna test rings to send bypass_call_guardrails.
ALLOW_BOLNA_GUARDRAIL_BYPASS=0
# Optional HTTPS URL of a real test-call recording for /demo. Do not add an audio file to the repo.
DEMO_AUDIO_URL=
CALL_BUDGET_MINUTES_DAILY=15
MAX_CALL_SECONDS=180

# WhatsApp (leave empty on staging; MOCK_WHATSAPP=1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# No `dev-wa-verify` fallback when NODE_ENV=production.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATES_APPROVED=0
WHATSAPP_APPROVED_TEMPLATES=
EMAIL_API_KEY=
# Mock email fallback. Default 1. Do not set MOCK_EMAIL=0 unless Priyansh says go.
MOCK_EMAIL=1
# Sign-in OTP From header. Empty = copy hides the address. Set on Vercel, never in git.
EMAIL_FROM=
SUPPORT_EMAIL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MOCK_WHATSAPP=1

# Pilot
SAATHI_KILL_SWITCH=0
OPS_EMAILS=
# Optional. Password cookie for /admin (full household dump + actions). Ops emails can skip it after sign-in.
# Leave empty in git. Set on Vercel. /admin 404s if this and OPS_EMAILS are both empty.
ADMIN_PASSWORD=
VOICE_ALERT_CHILD=0
LADDER_RETRY_10=10
LADDER_RETRY_25=25
LADDER_SOFT_30=30
LADDER_LAST_45=45
LADDER_ESCALATE_60=60
ALLOWED_PHONE_NUMBERS=
ALLOWED_EMAILS=
RETENTION_TRANSCRIPT_DAYS=30
RETENTION_SUMMARY_DAYS=90
