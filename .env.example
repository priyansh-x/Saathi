# Names only. Never commit values.
# Staging: copy every name into the Vercel project. Keep MOCK_*=1 and
# leave ALLOWED_PHONE_NUMBERS / ALLOWED_EMAILS empty. Priyansh deploys;
# see docs/saathi/engineering/deploy.md.

# Product
PRODUCT_NAME=Saathi
BRIEFING_CHANNEL=whatsapp
LANGUAGES=hi,en
PUBLIC_BASE_URL=http://127.0.0.1:43147
VIEWER_TZ=

# Desk session (HMAC cookie). Empty is fine while MOCK_WHATSAPP=1.
MAGIC_LINK_SECRET=

# Optional Postgres later. Empty = local PGlite at .data/saathi
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bolna (leave empty on staging; MOCK_BOLNA=1)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=
SAATHI_TOOL_TOKEN=
BOLNA_WEBHOOK_SECRET=
CRON_SECRET=
MOCK_BOLNA=1
CALL_PROVIDER=simulated
CALL_BUDGET_MINUTES_DAILY=15
MAX_CALL_SECONDS=180

# WhatsApp (leave empty on staging; MOCK_WHATSAPP=1)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATES_APPROVED=0
EMAIL_API_KEY=
MOCK_WHATSAPP=1

# Pilot
SAATHI_KILL_SWITCH=0
VOICE_ALERT_CHILD=0
LADDER_RETRY_10=10
LADDER_RETRY_25=25
LADDER_SOFT_30=30
LADDER_LAST_45=45
LADDER_ESCALATE_60=60
ALLOWED_PHONE_NUMBERS=
ALLOWED_EMAILS=
