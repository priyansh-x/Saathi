# Names only. Never commit values.
# Copy to .env.local. Keep MOCK_*=1 until you mean to go live.
# Deploy notes: docs/saathi/engineering/deploy.md

# Product
# Display name in the desk and emails.
PRODUCT_NAME=Saathi
# Child briefing channel name (whatsapp).
BRIEFING_CHANNEL=whatsapp
# Comma list of UI languages (hi,en).
LANGUAGES=hi,en
# Origin the family desk uses in emails and magic links.
PUBLIC_BASE_URL=http://127.0.0.1:43147
# Hosted family origin the Android shell loads. Must be https except `npx cap sync --dev`.
SAATHI_APP_URL=
# Local release signing only. Never commit the keystore or these values.
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
# IANA zone for the desk clock. Empty = Asia/Kolkata.
VIEWER_TZ=
# Local PGlite directory. Empty = .data/saathi. Tests may set this.
PGLITE_PATH=
# Screenshot helper bases (scripts/brand/screens.ts). Leave empty for local defaults.
FAMILY_BASE=
AUDIT_BASE=

# Desk session HMAC. Required in production (Vercel NODE_ENV=production) even with mocks on.
# openssl rand -hex 32
SESSION_SECRET=
# Deprecated alias for SESSION_SECRET.
MAGIC_LINK_SECRET=

# Optional Postgres later. Empty = local PGlite at .data/saathi.
DATABASE_URL=
# Landing waitlist + optional family OTP. Leave empty locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bolna (leave empty on staging; MOCK_BOLNA=1)
BOLNA_API_KEY=
# Bolna agent UUID. Empty in git.
BOLNA_AGENT_ID=
# Default https://api.bolna.ai
BOLNA_BASE_URL=
# Required in production even with MOCK_BOLNA=1. Must differ from BOLNA_WEBHOOK_SECRET.
# openssl rand -hex 32
BOLNA_TOOL_TOKEN=
# Deprecated alias for BOLNA_TOOL_TOKEN. Prefer BOLNA_TOOL_TOKEN.
SAATHI_TOOL_TOKEN=
# openssl rand -hex 32
BOLNA_WEBHOOK_SECRET=
# Required in production even with MOCK_BOLNA=1. Must differ from SESSION_SECRET, BOLNA_TOOL_TOKEN, and BOLNA_WEBHOOK_SECRET.
# openssl rand -hex 32
CRON_SECRET=
# Default 1. Do not set 0 in git.
MOCK_BOLNA=1
# simulated locally. bolna only on a live host the owner controls.
CALL_PROVIDER=simulated
# Default 0. Set 1 only if Priyansh wants Bolna test rings to send bypass_call_guardrails.
ALLOW_BOLNA_GUARDRAIL_BYPASS=0
# Optional HTTPS URL of a real test-call recording for /demo. Do not add an audio file to the repo.
DEMO_AUDIO_URL=
# Soft daily cap for live Bolna minutes.
CALL_BUDGET_MINUTES_DAILY=15
# Hard cap per call in seconds.
MAX_CALL_SECONDS=180

# WhatsApp (leave empty on staging; MOCK_WHATSAPP=1)
# Meta Cloud API user token. Empty in git.
WHATSAPP_TOKEN=
# Meta phone number id. Empty in git.
WHATSAPP_PHONE_NUMBER_ID=
# Meta WABA id. Empty in git.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# No `dev-wa-verify` fallback when NODE_ENV=production.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret for webhook signature. Empty in git.
WHATSAPP_APP_SECRET=
# Graph API version string.
WHATSAPP_GRAPH_VERSION=v21.0
# 0 until Meta approves template names.
WHATSAPP_TEMPLATES_APPROVED=0
# Comma list of approved name:lang (example: daily_briefing_good:en). Empty = none approved.
WHATSAPP_APPROVED_TEMPLATES=
# Optional transactional email API key. Empty in git.
EMAIL_API_KEY=
# Mock email fallback. Default 1. Do not set MOCK_EMAIL=0 unless Priyansh says go.
MOCK_EMAIL=1
# Sign-in OTP From header. Empty = copy hides the address. Set on Vercel, never in git.
EMAIL_FROM=
# Shown in privacy/support copy when set.
SUPPORT_EMAIL=
# Resend. Empty = unused.
RESEND_API_KEY=
# SMTP fallback for sign-in OTP. Empty = unused.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Alias for SMTP_PASS.
SMTP_PASSWORD=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Default 1. Do not set 0 in git.
MOCK_WHATSAPP=1

# Demo pharmacy page only. Default mock. Never set PARTNER_MODE=link.
PARTNER_MODE=mock

# Pilot
# 1 freezes cron, dials, and sends.
SAATHI_KILL_SWITCH=0
# Comma list of ops inboxes for /ops. Empty = nobody.
OPS_EMAILS=
# Optional. Password cookie for /admin (full household dump + actions). Ops emails can skip it after sign-in.
# Leave empty in git. Set on Vercel. /admin 404s if this and OPS_EMAILS are both empty.
ADMIN_PASSWORD=
# 1 also voice-alerts the child on some flags.
VOICE_ALERT_CHILD=0
# Missed-call ladder minutes after the first ring.
LADDER_RETRY_10=10
LADDER_RETRY_25=25
LADDER_SOFT_30=30
LADDER_LAST_45=45
LADDER_ESCALATE_60=60
# Empty = nobody is allowlisted. Env only. Never commit real numbers or inboxes.
ALLOWED_PHONE_NUMBERS=
ALLOWED_EMAILS=
# Days before transcripts are deleted.
RETENTION_TRANSCRIPT_DAYS=30
# Days before summaries and quotes are deleted.
RETENTION_SUMMARY_DAYS=90

# Web Push. Empty = generated and stored in ops_flags locally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: used in VAPID. Empty falls back to SUPPORT_EMAIL or support@example.com.
VAPID_SUBJECT=

# Landing site (landing/). Link to the family desk host.
FAMILY_DESK_URL=
NEXT_PUBLIC_FAMILY_DESK_URL=
# Optional waitlist count shown on the marketing site.
NEXT_PUBLIC_WAITLIST_COUNT=

# Vercel injects these. Listed because the desk reads them for PUBLIC_BASE_URL.
# VERCEL_URL=
# VERCEL_ENV=
# VERCEL_PROJECT_PRODUCTION_URL=
